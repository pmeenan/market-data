[Unit]
Description=market-data phase 1 seed hourly backfill sweep
Documentation=file://%h/src/market-data/README.md
ConditionPathExists=%h/src/market-data/data/meta.db
StartLimitIntervalSec=10min
StartLimitBurst=4

[Service]
Type=oneshot
WorkingDirectory=%h/src/market-data
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/src/market-data/.venv/bin/market-data --data-dir %h/src/market-data/data backfill intraday --phase 1 --freq 1hour --start 2016-12-12 --end 2026-08-27 --job-id phase1-seed-hourly-v1-20161212-20260827 --summary-json %h/src/market-data/data/operations/phase1-hourly-v1-status.json
# Identity gaps deliberately make the CLI exit 1 while validated peers still
# advance. Coordinator failures use exit 2 and receive bounded retries.
SuccessExitStatus=1
Restart=on-failure
RestartSec=2min
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/src/market-data/data
RestrictSUIDSGID=true
