[Unit]
Description=market-data phase 1 seed EOD backfill sweep
Documentation=file://%h/src/market-data/README.md
ConditionPathExists=%h/src/market-data/data/meta.db

[Service]
Type=oneshot
WorkingDirectory=%h/src/market-data
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/src/market-data/.venv/bin/market-data --data-dir %h/src/market-data/data backfill eod --phase 1 --start 2006-08-28 --end 2026-08-27 --job-id phase1-seed-eod-20060828-20260827 --summary-json %h/src/market-data/data/operations/phase1-eod-status.json
# Identity gaps deliberately make the CLI exit 1 while validated peers still
# advance. The atomic JSON summary retains the blocked/failed distinction.
SuccessExitStatus=1
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/src/market-data/data
RestrictSUIDSGID=true

