[Unit]
Description=market-data phase 1 seed EOD backfill sweep
Documentation=file://%h/src/market-data/README.md
ConditionPathExists=%h/src/market-data/data/meta.db
StartLimitIntervalSec=10min
StartLimitBurst=4

[Service]
Type=oneshot
WorkingDirectory=%h/src/market-data
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/src/market-data/.venv/bin/market-data --data-dir %h/src/market-data/data backfill eod --phase 1 --start 2006-08-28 --end 2026-08-27 --job-id phase1-seed-eod-episodes-v3-20060828-20260827 --summary-json %h/src/market-data/data/operations/phase1-eod-episodes-v3-status.json
# Identity gaps deliberately make the CLI exit 1 while validated peers still
# advance. Coordinator failures use exit 2 and receive bounded retries.
SuccessExitStatus=1
Restart=on-failure
RestartSec=2min
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/src/market-data/data
RestrictSUIDSGID=true
