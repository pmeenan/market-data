[Unit]
Description=market-data nightly current EOD collection
Documentation=file://%h/src/market-data/README.md
ConditionPathExists=%h/src/market-data/data/meta.db
StartLimitIntervalSec=10min
StartLimitBurst=4

[Service]
Type=oneshot
WorkingDirectory=%h/src/market-data
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/src/market-data/.venv/bin/market-data --data-dir %h/src/market-data/data update --refresh-identities --status-json %h/src/market-data/data/operations/current-eod-status.json
# Per-symbol identity/vendor failures are a completed partial pass. Coordinator,
# configuration, lock, and report-publication failures use exit 2 and retry.
SuccessExitStatus=1
Restart=on-failure
RestartSec=2min
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/src/market-data/data
RestrictSUIDSGID=true
